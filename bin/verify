# Main
# ==========================================================================
[ $# -le 1 ] || fail "usage: bin/verify [--js | --swift | --selftest | FILE.js]" 2
mode=${1:-all}

case $mode in
  --selftest) selftest ;;
  --js|--swift|all) ;;
  -*) fail "usage: bin/verify [--js | --swift | --selftest | FILE.js]" 2 ;;
  *)  verify_js "$mode"; exit $? ;;
esac

rc=0; summary=""; okline=""
note() { [ "$1" -eq 0 ] || { [ "$1" -gt "$rc" ] && rc=$1; summary="${summary:+$summary; }$2"; }; }

if [ "$mode" != --swift ]; then
  [ -f "$ROOT/web/instagram.js" ] || fail "file not found: web/instagram.js" 2
  # Every script in web/ is injected or could be: each one must be a known, checked file.
  stray=$(find "$ROOT/web" -type f \( -name '*.js' -o -name '*.mjs' -o -name '*.cjs' \) \
            ! -path "$ROOT/web/instagram.js" ! -path "$ROOT/web/youtube.js" \
            ! -path "$ROOT/web/youtube-ads.js" -printf '%P ' 2>/dev/null)
  [ -z "$stray" ] || note 1 "unexpected script(s) in web/: $stray"
  for f in "$ROOT/web/instagram.js" "$ROOT/web/youtube.js" "$ROOT/web/youtube-ads.js"; do
    [ -f "$f" ] || continue
    name=$(basename "$f" .js)
    printf '== web/%s.js\n' "$name"
    out=$(verify_js "$f"); r=$?
    printf '%s\n' "$out" | sed '$d'
    last=$(printf '%s\n' "$out" | tail -1)
    if [ $r -eq 0 ]; then okline="$okline $name=${last#OK sha256=}"
    else note $r "$name.js: ${last#FAIL }"; fi
  done
fi

if [ "$mode" != --js ]; then
  printf '== ios/\n'
  out=$(verify_swift); r=$?
  printf '%s\n' "$out" | sed '$d'
  last=$(printf '%s\n' "$out" | tail -1)
  if [ $r -eq 0 ]; then okline="$okline ${last#OK }"; else note $r "ios/: ${last#FAIL }"; fi

  printf '== secrets\n'
  out=$(verify_secrets); r=$?
  [ -z "$out" ] || printf '%s\n' "$out" | { [ $r -eq 0 ] && cat || sed '$d'; }
  note $r "secret material in the repository"
fi

[ $rc -eq 0 ] || fail "$summary" "$rc"
printf 'OK%s\n' "$okline"
exit 0
