#!/usr/bin/env bash
# Creates the herdr "ReelFree" workspace: tab "dashboard" + tab "agents" (2x2 Claude grid) and sends kickoff prompts.
# Usage: bin/launch [--no-kickoff]
set -euo pipefail
[ "${HERDR_ENV:-}" = 1 ] || { echo "pas dans herdr" >&2; exit 1; }
cd "$(dirname "$0")/.."; ROOT=$PWD
j() { jq -r "$1"; }

if [ -n "${RF_PANES:-}" ]; then
  read -r DASH P1 P2 P3 P4 <<<"$RF_PANES"
else
ws=$(herdr workspace create --cwd "$ROOT" --label ReelFree --no-focus)
WS=$(j .result.workspace.workspace_id <<<"$ws"); DASH=$(j .result.root_pane.pane_id <<<"$ws"); T1=$(j .result.tab.tab_id <<<"$ws")
herdr tab rename "$T1" dashboard >/dev/null
herdr pane rename "$DASH" "📊 dashboard" >/dev/null
herdr pane run "$DASH" "bin/dashboard"

tab=$(herdr tab create --workspace "$WS" --cwd "$ROOT" --label agents --no-focus)
P1=$(j .result.root_pane.pane_id <<<"$tab")
P2=$(herdr pane split "$P1" --direction right --cwd "$ROOT" --no-focus | j .result.pane.pane_id)
P3=$(herdr pane split "$P1" --direction down  --cwd "$ROOT" --no-focus | j .result.pane.pane_id)
P4=$(herdr pane split "$P2" --direction down  --cwd "$ROOT" --no-focus | j .result.pane.pane_id)
fi

declare -A PANE=([rf-recon]=$P1 [rf-core]=$P2 [rf-qa]=$P3 [rf-sec]=$P4)
declare -A COLOR=([rf-recon]=teal [rf-core]=orange [rf-qa]=green [rf-sec]=red)
declare -A SQ=([teal]=🩵 [orange]=🟧 [green]=🟩 [red]=🟥)

for a in rf-recon rf-core rf-qa rf-sec; do
  p=${PANE[$a]}; c=${COLOR[$a]}
  herdr pane rename "$p" "${SQ[$c]} $a" >/dev/null
  if ! herdr agent get "$a" >/dev/null 2>&1; then
    herdr agent start "$a" --kind claude --pane "$p" --timeout 60000 >/dev/null 2>&1 || true
  fi
  herdr agent wait "$a" --until idle --timeout 60000 >/dev/null || { echo "✗ $a pas prêt :"; herdr agent read "$a" --source visible | tail -12; exit 1; }
  herdr agent prompt "$a" "/color $c" >/dev/null; sleep 1
  herdr agent prompt "$a" "/rename $a" >/dev/null; sleep 1
  echo "$a $c" >> "${XDG_CACHE_HOME:-$HOME/.cache}/hcc/colors"
  echo "✓ $a → $p"
done

[ "${1:-}" = --no-kickoff ] && exit 0
common="Tu es l'agent NAME du projet ReelFree. Lis d'abord CLAUDE.md, docs/SPEC.md et board/TASKS.md. Respecte le protocole : tes tâches @NAME dans board/TASKS.md, ton statut dans board/status/NAME.md (1re ligne = statut en une phrase, mets-la à jour à chaque étape), tu n'écris que dans ton périmètre, et tu utilises des sous-agents (outil Agent) en parallèle pour les sous-tâches indépendantes."
declare -A GO=(
 [rf-recon]="Commence par T01–T03. Si Chrome (claude-in-chrome) est disponible et qu'Arthur est connecté à Instagram, utilise-le avec un viewport mobile (414x896) en navigation passive uniquement : ne like pas, ne poste pas, n'envoie pas de message. Sinon, documente ce qu'on sait déjà (sources publiques) et marque [!] ce qui demande le vrai site. Ensuite T04 : des fixtures anonymisées, sans aucun nom, message ou token réel."
 [rf-core]="Commence par T05 puis T06. La fonction decide(path, ctx) doit être pure, et exportée pour les tests quand le script tourne sous Node (typeof module !== 'undefined'). Pour les sélecteurs, mets des TODO en attendant docs/recon.md de rf-recon, puis intègre-les dès qu'ils sont là."
 [rf-qa]="Commence par T07 puis T08. Installe Playwright WebKit (npx playwright install webkit) et utilise devices['iPhone 11']. Écris un test runner (npm test) qui met à jour board/last-test.txt. Coordonne la signature de decide() avec rf-core via board/status."
 [rf-sec]="Commence par T10 (bin/verify, qui doit sortir en code non nul si une API interdite est trouvée et afficher en dernière ligne 'OK sha256=<12 premiers caractères>' ou 'FAIL <raison>'), puis T09 et T11. Ensuite, surveille src/ et fais la revue au fil de l'eau : remonte tout écart dans board/status/rf-sec.md sous ## Demandes."
)
for a in rf-recon rf-core rf-qa rf-sec; do
  herdr agent prompt "$a" "${common//NAME/$a} ${GO[$a]}" >/dev/null
  echo "→ kickoff envoyé à $a"
done
echo "Workspace ReelFree prêt. Dashboard : $DASH"
